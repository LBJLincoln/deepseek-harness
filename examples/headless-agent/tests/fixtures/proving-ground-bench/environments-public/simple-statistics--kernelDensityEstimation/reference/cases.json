ple, function (u) {\n            return Math.exp(-0.5 * u * u) / SQRT_2PI;\n        });\n        for (let i = 0; i < normallyDistributed.density.length; i++) {\n            const x = normallyDistributed.density[i][0];\n            assert.equal(defaultKde(x), explicitKde(x));\n            assert.equal(defaultKde(x), functionKde(x));\n        }\n}\n}\n}\n",
