# The repo's canonical text form is LF, enforced at checkout too: no smudge
# boundary between working tree and repo, so byte-level gates (verify-*
# comparisons, blob hashing, coverage offsets) see one form on every host.
# If a file class ever genuinely needs CRLF in the working tree (.bat/.cmd
# for cmd.exe), add a `*.bat text eol=crlf` override AFTER this line — the
# in-repo form stays LF; CRLF becomes checkout-time presentation only.
* text=auto eol=lf

*.pdf binary
*.gz binary

# Raw session transcripts are kept byte-for-byte as collected: the manifest
# digests are computed over the source bytes, so no EOL normalization and no
# whitespace policing applies to them.
data/transcripts/*/raw/** -text -whitespace

# Pairing records are generated from the three confirmed owner-blob pairs.
# The worktree-local installer registers the fail-closed driver command.
*.i18n.yaml merge=dsh-translation-pairing

# Append-only machine ledgers: several writers (the shift engine, the
# enterprise functions, the nightly loop, an operator's recovered record)
# append to the same file and push concurrently, so a rebase meets two sides
# that each added lines at the end, which stopped a cycle mid-rebase. The
# built-in union driver keeps both sides' lines. Two writers never append for
# the same ticket or run at once, so the latest-line-per-ticket reading is
# unchanged; the roster names the prefix it covers and the next cycle
# regenerates it over the merged file.
data/enterprise/ledger.jsonl merge=union
data/proving-ground/loop/ledger.jsonl merge=union
data/proving-ground/loop/preflight.jsonl merge=union
